{
  "rules": {
    "server": {
      "$key": {
        ".read": "auth != null"
      },
      "feedback": {
        "$feedbackId": {
          ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid"
        }
      }
    },
    "trips": {
      "$tripId": {
        ".read": "auth != null && data.child('members').child(auth.uid).val() === true",
        ".write": "auth != null && (data.child('members').child(auth.uid).val() === true || (!data.exists() && newData.child('members').child(auth.uid).val() === true))",
        "members": {
          "$uid": {
            ".write": "auth != null && $uid === auth.uid && newData.val() === true && root.child('trips').child($tripId).exists()"
          }
        },
        "tripName": {
          ".read": "auth != null"
        },
        "$userId": {
          "expenses": {
            ".indexOn": [
              "serverTimestamp"
            ]
          }
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && $uid === auth.uid",
        ".write": "auth != null && $uid === auth.uid",
        "userName": {
          ".read": "auth != null"
        }
      }
    },
    "splitHistory": {
      "$tripId": {
        ".read": "auth != null && root.child('trips').child($tripId).child('members').child(auth.uid).val() === true",
        "$entryId": {
          ".write": "auth != null && root.child('trips').child($tripId).child('members').child(auth.uid).val() === true && !data.exists() && newData.exists()",
          ".validate": "newData.hasChildren(['id', 'kind', 'byUid', 'byName', 'timestamp', 'tripCurrency', 'balanceChanges']) && newData.child('id').val() === $entryId && newData.child('byUid').val() === auth.uid && newData.child('kind').isString() && newData.child('kind').val().matches(/^(added|edited|deleted|undone|paidBack|settlement)$/) && newData.child('byName').isString() && newData.child('byName').val().length <= 100 && newData.child('timestamp').isNumber() && newData.child('tripCurrency').isString() && (!newData.child('description').exists() || (newData.child('description').isString() && newData.child('description').val().length <= 500))",
          "id": { ".validate": true },
          "kind": { ".validate": true },
          "description": { ".validate": true },
          "byUid": { ".validate": true },
          "byName": { ".validate": true },
          "timestamp": { ".validate": true },
          "tripCurrency": { ".validate": "newData.val().length <= 10" },
          "balanceChanges": {
            ".validate": "newData.hasChildren()",
            "$change": {
              ".validate": "$change.matches(/^([0-9]|[1-9][0-9])$/) && newData.hasChildren(['userName', 'amount']) && newData.child('userName').isString() && newData.child('userName').val().length <= 100 && newData.child('amount').isNumber()",
              "userName": { ".validate": true },
              "amount": { ".validate": true },
              "range": {
            ".validate": "newData.hasChildren(['rangeId', 'startDate', 'endDate']) && newData.child('rangeId').isString() && newData.child('startDate').isString() && newData.child('endDate').isString()"
          },
          "days": {
            ".validate": "newData.hasChildren()",
            "$dayIndex": {
              ".validate": "newData.hasChildren(['date', 'balanceChanges']) && newData.child('date').isString()"
            }
          },
          "$other": { ".validate": false }
            }
          },
          "range": {
            ".validate": "newData.hasChildren(['rangeId', 'startDate', 'endDate']) && newData.child('rangeId').isString() && newData.child('startDate').isString() && newData.child('endDate').isString()"
          },
          "days": {
            ".validate": "newData.hasChildren()",
            "$dayIndex": {
              ".validate": "newData.hasChildren(['date', 'balanceChanges']) && newData.child('date').isString()"
            }
          },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
